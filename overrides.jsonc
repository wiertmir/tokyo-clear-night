// Tokyo Clear Night: color overrides applied on top of Tokyo Night.
// Brighter UI chrome (Tokyo Night's defaults are quite dim).
// Teal (#73daca) is Tokyo Night's own accent, used for highlights;
// the selected file in Explorer is barely brighter than default text, on a noticeably lighter background.
{
    "colors": {
        // General text & icons
        "foreground": "#c0caf5",
        "descriptionForeground": "#a9b1d6",
        "icon.foreground": "#c0caf5",
        "errorForeground": "#db4b4b",  // red (Tokyo Night's editorOverviewRuler.errorForeground); its default #515670 is grey

        // Title bar & menus
        "titleBar.activeForeground": "#c0caf5",
        "titleBar.inactiveForeground": "#8089b3",
        "menubar.selectionForeground": "#ffffff",
        "menu.foreground": "#c0caf5",
        "menu.selectionForeground": "#1a1b26",
        "menu.selectionBackground": "#73daca",

        // Breadcrumbs
        "breadcrumb.foreground": "#a9b1d6",
        "breadcrumb.focusForeground": "#c0caf5",
        "breadcrumb.activeSelectionForeground": "#73daca",

        // Sidebar / Explorer
        "sideBar.foreground": "#c0caf5",
        "sideBarTitle.foreground": "#c0caf5",
        "sideBarSectionHeader.foreground": "#c0caf5",
        "list.hoverForeground": "#ffffff",
        "list.activeSelectionForeground": "#e3d1af",
        "list.activeSelectionBackground": "#364a82",
        "list.inactiveSelectionForeground": "#e0af68",
        "list.inactiveSelectionBackground": "#2a3040",
        "list.focusOutline": "#3b4261",

        // Inline edit boxes (e.g. Explorer rename) & other text inputs
        "input.background": "#242c48",
        "input.foreground": "#c0caf5",
        "input.border": "#2d5c46",
        "focusBorder": "#2d5c4680",

        // Activity bar (left icon strip)
        "activityBar.foreground": "#c0caf5",
        "activityBar.inactiveForeground": "#8089b3",
        "activityBar.activeBorder": "#73daca",

        // Tabs
        "tab.activeForeground": "#c0caf5",
        "tab.inactiveForeground": "#8089b3",
        "tab.activeBorder": "#73daca",

        // Scrollbars
        "scrollbarSlider.background": "#7aa2f755",
        "scrollbarSlider.hoverBackground": "#7aa2f777",
        "scrollbarSlider.activeBackground": "#7aa2f7aa",

        // Notebooks: lighter page behind darker cells
        "notebook.editorBackground": "#262a3d",
        "notebook.cellEditorBackground": "#16161e",
        "notebook.cellBorderColor": "#3b4261",
        "notebook.focusedEditorBorder": "#73daca80",
        "notebook.focusedCellBorder": "#73daca",
        "notebook.cellToolbarSeparator": "#3b4261",
        "notebook.outputContainerBackgroundColor": "#2d3040"
    },
    // Use Pylance/language-server tokens on top of TextMate (Tokyo Night leaves this off,
    // so its semanticTokenColors were never applied).
    "semanticHighlighting": true,
    // Named colors are from https://coolors.co/colors.
    "tokenColors": [
        {
            // Class names were plain foreground. Fresh Sky: saturated, and away from the function blue.
            // Semantic "class" tokens fall back to this scope, so class usages match too.
            "name": "Class Name",
            "scope": ["entity.name.type.class", "entity.name.class"],
            "settings": { "foreground": "#45b1e8" }
        },
        {
            // Other type names: type aliases and type parameters. Tropical Teal.
            "name": "Type Name",
            "scope": ["entity.name.type"],
            "settings": { "foreground": "#43b3ae" }
        },
        {
            // All docstrings look like comments (raw and single-quoted ones were plain strings).
            "name": "Docstrings",
            "scope": ["string.quoted.docstring"],
            "settings": { "foreground": "#51597d", "fontStyle": "italic" }
        },
        {
            "name": "TODO / FIXME tags",
            "scope": ["keyword.codetag.notation"],
            "settings": { "foreground": "#e0af68", "fontStyle": "bold" }
        },
        {
            // Lowercase r"..." strings are scoped as regexp by the Python grammar. Muted Olive.
            "name": "Raw strings",
            "scope": ["string.quoted.raw", "string.regexp.quoted"],
            "settings": { "foreground": "#9ab973" }
        },
        {
            // Whole f-string: prefix, text, quotes, braces and format spec. Tea Green.
            "name": "f-strings",
            "scope": [
                "meta.fstring.python string",
                "meta.fstring.python string.quoted.raw",
                "meta.fstring.python storage.type.string",
                "meta.fstring.python storage.type.format",
                "meta.fstring.python constant.character.format.placeholder",
                "meta.fstring.python punctuation.definition.string"
            ],
            "settings": { "foreground": "#d0f0c0" }
        },
        {
            // Pylance also reports these as built-in classes, which overrides this color.
            "name": "Built-in exceptions",
            "scope": ["support.type.exception.python"],
            "settings": { "foreground": "#bf4f51" }
        },
        {
            "name": "global / nonlocal",
            "scope": ["storage.modifier.declaration.python"],
            "settings": { "foreground": "#6f00ff" }
        },
        {
            // TextMate fallback for decorators, including the "@". Rosy Taupe 35% toward plain text.
            "name": "Decorators",
            "scope": ["entity.name.function.decorator.python", "punctuation.definition.decorator.python"],
            "settings": { "foreground": "#b59ba8", "fontStyle": "italic" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#f19cbb" }
        },
        {
            // TextMate fallback for self/cls in signatures: Tokyo Night's orange (swapped with keyword arguments).
            "name": "self / cls in signature",
            "scope": ["variable.parameter.function.language.special.self", "variable.parameter.function.language.special.cls"],
            "settings": { "foreground": "#e0af68" }
        },
        {
            // TextMate fallback for self/cls in bodies: Tokyo Night's red, muted (60% chroma, a bit darker; greying it hits the number pink).
            "name": "self / cls in body",
            "scope": ["variable.language.special.self", "variable.language.special.cls"],
            "settings": { "foreground": "#ca7e89" }
        },
        {
            // Log files (VS Code's Log grammar). Errors were plain/green. #b31b1b 35% toward log text, then 20% brighter.
            "name": "Log errors",
            "scope": ["log.error", "log.exceptiontype"],
            "settings": { "foreground": "#cc5a6c" }
        },
        {
            // Stack-trace lines ("at ...") were string green. #d0417e 40% toward log text.
            "name": "Log stack traces",
            "scope": ["log.exception"],
            "settings": { "foreground": "#ba699e" }
        },
        {
            // Warnings were a dim maroon that would read like errors. Tokyo Night yellow.
            "name": "Log warnings",
            "scope": ["log.warning"],
            "settings": { "foreground": "#e0af68" }
        },
        {
            // Info was a dim teal (#449dab); same hue, brighter.
            "name": "Log info",
            "scope": ["log.info"],
            "settings": { "foreground": "#58ccde" }
        },
        {
            // Numbers, GUIDs, hashes, URLs and dotted names were constant orange; log files only. Sand Dune halfway to log text (#9aa5ce).
            "name": "Log constants",
            "scope": ["log.constant", "text.log constant.language"],
            "settings": { "foreground": "#c2c2cb" }
        }
    ],
    "semanticTokenColors": {
        // Pylance marks built-ins with "builtin", not "defaultLibrary", so Tokyo Night's rules miss them.
        "*.builtin": "#0db9d7",
        // Pylance maps self/cls to parameter orange everywhere; match the TextMate fallbacks above.
        "selfParameter": "#ca7e89",
        "clsParameter": "#ca7e89",
        "selfParameter.declaration": "#e0af68",
        "clsParameter.declaration": "#e0af68",
        "*.decorator": { "foreground": "#b59ba8", "italic": true },
        // Tokyo Night's semantic "parameter" beige would hide its TextMate keyword-argument orange.
        "parameter.keywordArgument": "#cab094", // Tokyo Night's orange, 40% toward plain text
        // Parameter uses: plain text, as Tokyo Night shows them (its semantic beige never applied there).
        "parameter": "#a9b1d6",
        "enum": "#41a6b5",
        "enumMember": "#ffcba4",
        // Modules were the built-in color; Tokyo Night colors them #7dcfff. Cool Steel 50% toward olive.
        "namespace": "#98a288",
        // Tokyo Night colors every assignment like a keyword.
        "variable.declaration": "#c0caf5",
        // Read-only variables: constant orange 35% toward plain text (beats the plain declaration rule).
        "variable.readonly": "#e1a58c",
        "variable.declaration.readonly": "#e1a58c",
        // Rust (rust-analyzer): std functions/methods stay function blue instead of the std-library cyan; macros are Taupe.
        "function.defaultLibrary": "#7aa2f7",
        "method.defaultLibrary": "#7aa2f7",
        "macro": "#98817b",
        "macro.defaultLibrary": "#98817b",
        // const/static/enum variants were swallowed by variable.declaration; read-only orange as in Python.
        "const": "#e1a58c",
        "const.declaration": "#e1a58c",
        "static": "#e1a58c",
        "static.declaration": "#e1a58c",
        "constParameter": "#e1a58c",
        "enumMember.declaration": "#ffcba4",
        // Rust self / Self: light gold (Python self/cls keep the muted red above).
        "selfKeyword": "#eedc82",
        "selfTypeKeyword": "#eedc82",
        "selfKeyword.declaration": "#eedc82",
        "property": "#7dcfff",
        "property.declaration": "#73daca",
        "builtinAttribute": { "foreground": "#cc6a3d", "italic": true },
        "decorator": { "foreground": "#cc6a3d", "italic": true },
        "derive": { "foreground": "#cc6a3d", "italic": true },
        "decorator.defaultLibrary": { "foreground": "#cc6a3d", "italic": true },
        "derive.defaultLibrary": { "foreground": "#cc6a3d", "italic": true },
        // Traits (rust-analyzer "interface"): italic sea-mist, hazy like an abstraction and clear of the purple italics.
        "interface": { "foreground": "#8fb3ad", "italic": true },
        // Methods that take self by value move their receiver: same blue, bold. The std rule is listed too so it wins over "method.defaultLibrary".
        "method.consuming": { "foreground": "#7aa2f7", "bold": true },
        "method.defaultLibrary.consuming": { "foreground": "#7aa2f7", "bold": true },
        "*.deprecated": { "strikethrough": true }
    }
}
